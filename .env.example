# 향후 실행 코드에서 사용할 환경 설정의 초안입니다.
# 현재는 이 파일이나 .env를 읽는 실행 코드가 없습니다.
# 로컬 설정이 필요해지면 .env로 복사하여 사용합니다.

# 정제·가명 처리한 강좌 DB의 로컬 경로
COURSE_DB_PATH=data/courses.sqlite3

# 계획서 기준 모델 후보: 구동 검증 후 확정
BASE_MODEL_ID=unsloth/Meta-Llama-3.1-8B-Instruct
SQL_ADAPTER_ID=huggingface-KREW/Llama-3.1-8B-Spider-SQL-Ko

# 로컬 조회 서버
GRADIO_SERVER_NAME=127.0.0.1
GRADIO_SERVER_PORT=7860
MAX_RESULT_ROWS=200

# Gemini 모델명은 선택 기능 구현 시 확인하여 지정합니다.
# API 키는 화면에서 입력받을 계획이므로 여기에 포함하지 않습니다.
GEMINI_MODEL=
