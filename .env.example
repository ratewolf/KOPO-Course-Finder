# 필요하면 .env로 복사하여 기본 설정을 변경합니다.
# Compose는 .env가 없으면 compose.yaml의 기본값을 사용합니다.
# 모델·SQL 관련 값은 향후 앱 코드에서 읽도록 구현할 예정입니다.

# 호스트 접속 포트: 컨테이너 내부의 Gradio는 0.0.0.0:7860 사용
APP_PORT=7860

# 정제·가명 처리한 강좌 DB (컨테이너의 /workspace 기준 상대 경로)
COURSE_DB_PATH=data/courses.sqlite3

# SQL 어댑터 설정에 맞춘 사전 양자화 기반 모델과 확인한 리비전
BASE_MODEL_ID=unsloth/Meta-Llama-3.1-8B-Instruct-bnb-4bit
BASE_MODEL_REVISION=f15c379fb32bb402fa06a7ae9aecb1febf4b79ec
SQL_ADAPTER_ID=huggingface-KREW/Llama-3.1-8B-Spider-SQL-Ko
SQL_ADAPTER_REVISION=11d1e533ccbe48c9135baeba83a16205ca4ca251

# 로컬 GPU 추론: 입력 초과 시 잘라내지 않고 안내하도록 구현 예정
MODEL_COMPUTE_DTYPE=float16
MODEL_MAX_INPUT_TOKENS=2048
MODEL_MAX_NEW_TOKENS=256
MODEL_MAX_SECONDS=60

# SQL 실행 제한
MAX_RESULT_ROWS=200
SQL_TIMEOUT_SECONDS=5

# 필요한 모델 파일이 캐시에 준비된 뒤 1로 변경하면 오프라인 조회 가능
HF_HUB_OFFLINE=0

# 후속 질문의 맥락 해석·질문 재작성용 모델입니다. 결과 안내는 로컬에서 처리합니다.
# 실제 사용 가능한 모델명과 무료 등급 지원은 연동 구현 시 확인합니다.
# API 키는 화면에서 입력받을 계획이므로 여기에 포함하지 않습니다.
GEMINI_MODEL=gemini-3.5-flash-lite
